# Clever Dictate — environment configuration.
#
# Copy this file to `.env` and edit any values you need to override.
# The `.env` file is gitignored and must never be committed.
# Every value here has a sensible default in code, so you can also leave
# `.env` missing entirely for a first-run demo.

# ── Security ─────────────────────────────────────────────────
# Signing key for session cookies. If unset, the app generates a random
# key on first launch and persists it to `data/.secret_key`, so sessions
# survive restarts on the same machine. Set explicitly for real deployments.
SECRET_KEY=

# ── Whisper (transcription) ──────────────────────────────────
# Model used for local speech-to-text. Options in order of accuracy vs
# speed: tiny.en, base.en, small.en, medium.en, large-v3.
# `small.en` is a reasonable default on CPU.
WHISPER_MODEL=small.en

# ── LLM (cleanup, auto-title, reformat, translate, ask) ──────
# Ollama HTTP endpoint. Leave blank to skip every LLM feature and fall
# back to raw output; the app still runs, transcription still works.
# `localhost` mirrors the original macOS app which ran on-device.
OLLAMA_URL=http://localhost:11434

# Ollama model. `qwen2.5:1.5b` mirrors the original app's local model
# (Qwen2.5-1.5B via MLX). Pull once with: `ollama pull qwen2.5:1.5b`.
OLLAMA_MODEL=qwen2.5:1.5b

# Recordings shorter than this stay raw. Longer ones get the cleanup pass.
CLEANUP_THRESHOLD_S=15

# ── Storage (optional) ───────────────────────────────────────
# Override the data directory (SQLite DB, secret key, uploads). Default: ./data
# DATA_DIR=data

# Override the SQLite database URL. Default is inside DATA_DIR.
# Example for Postgres: postgresql://user:pass@host:5432/dictate
# DB_URL=sqlite:///data/dictate.db
